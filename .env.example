# RealTools — environment variables
# Copy this file to .env.local and fill in values from the Supabase dashboard.
# NEVER commit .env.local.

# Supabase — Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role — server-only, NEVER NEXT_PUBLIC_*
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App URL — used for auth callback redirects and OM tracking links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Clerk auth — Dashboard -> API Keys. Publishable is client-safe; secret is server-only.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-publishable-key
CLERK_SECRET_KEY=sk_test_your-secret-key

# Resend — OM email delivery. No key = sends are recorded but NO email goes out.
# Requires a VERIFIED sending domain (SPF/DKIM) before real delivery works.
RESEND_API_KEY=re_your-resend-key
RESEND_FROM_EMAIL=noreply@your-verified-domain.com

# Google Maps/Places — real nearby-business cards in location intelligence.
# No key = nearby-business cards render empty (mock sources are hidden).
GOOGLE_MAPS_API_KEY=your-google-maps-key

# AI Deal Summary — server-only, optional.
# Valid providers: gemini, openrouter. If no key is set, summaries fail gracefully.
# For gemini: use gemini-2.0-flash or gemini-1.5-pro; requires GEMINI_API_KEY
# For openrouter: use google/gemini-2.0-flash-exp; requires OPENROUTER_API_KEY
AI_DEAL_SUMMARY_PROVIDER=gemini
AI_DEAL_SUMMARY_MODEL=gemini-2.0-flash
AI_DEAL_SUMMARY_TEMPERATURE=0.3
GEMINI_API_KEY=your-gemini-api-key
