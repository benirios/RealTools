generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Temperature {
  id        Int      @id @default(autoincrement())
  room_id   String
  value     Float
  timestamp DateTime
}

model Announcement {
  id         Int      @id @default(autoincrement())
  title      String
  message    String
  priority   Int      @default(0)
  created_at DateTime @default(now())
}
